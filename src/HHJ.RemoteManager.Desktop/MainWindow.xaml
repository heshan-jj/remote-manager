<Window x:Class="HHJ.RemoteManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HHJ Remote Manager"
        Width="1280" Height="820" MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,16">
                    <TextBlock Text="HHJ Remote Manager" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Personal RMM Control Panel" Foreground="{StaticResource TextMuted}" FontSize="11" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,4">
                    <TextBlock Text="Active Device" Foreground="{StaticResource TextMuted}" FontSize="11" />
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Connect" Command="{Binding ConnectSelectedCommand}" Margin="0,0,6,0" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionStateDisplay}" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>

                <ListBox SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                    <ListBoxItem Content="Dashboard" Padding="10,9" />
                    <ListBoxItem Content="Devices &amp; Keys" Padding="10,9" />
                    <ListBoxItem Content="Processes" Padding="10,9" />
                    <ListBoxItem Content="Services" Padding="10,9" />
                    <ListBoxItem Content="SSH Terminal" Padding="10,9" />
                    <ListBoxItem Content="Actions &amp; Events" Padding="10,9" />
                    <ListBoxItem Content="Logs" Padding="10,9" />
                    <ListBoxItem Content="Settings" Padding="10,9" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Status Bar -->
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedDevice.DisplayName, FallbackValue='No device selected'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding SelectedDevice.Address}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding LatencyDisplay, StringFormat='RTT: {0}'}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding LastUpdatedDisplay, StringFormat='Updated: {0}'}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Error / Notice Banner -->
            <StackPanel Grid.Row="1">
                <Border Background="#3B1D22" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                        Visibility="{Binding ConnectionErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ConnectionErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" />
                </Border>
                <Border Background="#1D2A3A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                        Visibility="{Binding BannerNotice, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding BannerNotice}" Foreground="#BFDBFE" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Tab Content -->
            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- 0: Dashboard -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Summary Cards -->
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU UTILIZATION" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding CpuDisplay}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="MEMORY" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding RamDisplay}" FontSize="15" FontWeight="Bold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="NETWORK THROUGHPUT" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding NetworkDisplay}" FontSize="14" FontWeight="Bold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SYSTEM UPTIME" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding UptimeDisplay}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Charts -->
                            <Grid Height="210" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="CPU % History" Foreground="{StaticResource TextMuted}" Margin="4,0,0,4" />
                                        <lvc:CartesianChart Series="{Binding CpuSeries}" YAxes="{Binding PercentYAxes}" XAxes="{Binding HiddenXAxes}" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Memory % History" Foreground="{StaticResource TextMuted}" Margin="4,0,0,4" />
                                        <lvc:CartesianChart Series="{Binding RamSeries}" YAxes="{Binding PercentYAxes}" XAxes="{Binding HiddenXAxes}" />
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Grid Height="180" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Network Throughput (KB/s)" Foreground="{StaticResource TextMuted}" Margin="4,0,0,4" />
                                        <lvc:CartesianChart Series="{Binding NetworkSeries}" XAxes="{Binding HiddenXAxes}" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Logical Disks" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                                        <DataGrid ItemsSource="{Binding Disks}" Height="125">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Drive" Binding="{Binding DeviceId}" Width="60" />
                                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="110" />
                                                <DataGridTextColumn Header="FS" Binding="{Binding FileSystem}" Width="60" />
                                                <DataGridTextColumn Header="Free (bytes)" Binding="{Binding FreeBytes}" Width="*" />
                                                <DataGridTextColumn Header="Used %" Binding="{Binding UsedPercent, StringFormat={}{0:0}%}" Width="70" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- System Information -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="System Information" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding SysComputerName, StringFormat='Computer: {0}'}" Margin="0,2" />
                                        <TextBlock Text="{Binding SysOs, StringFormat='OS: {0}'}" Margin="0,2" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SysCpu, StringFormat='CPU: {0}'}" Margin="0,2" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Management Status" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding SysRam, StringFormat='Installed RAM: {0}'}" Margin="0,2" />
                                        <TextBlock Text="{Binding SysSshd, StringFormat='OpenSSH Service: {0}'}" Margin="0,2" />
                                        <TextBlock Text="{Binding SysUser, StringFormat='Authenticated As: {0}'}" Margin="0,2" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 1: Devices & Keys -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="240" />
                        </Grid.RowDefinitions>

                        <!-- Devices + Diagnostics -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Add Device" Click="OnAddDeviceClick" />
                                        <Button Content="Edit Device" Margin="8,0,0,0" Click="OnEditDeviceClick" />
                                        <Button Style="{StaticResource DangerButton}" Content="Remove" Margin="8,0,0,0" Command="{Binding RemoveSelectedDeviceCommand}" />
                                        <Button Content="Test / Diagnostics" Margin="8,0,0,0" Command="{Binding RunDiagnosticsCommand}" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="140" />
                                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" />
                                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" />
                                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Connection Diagnostics" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding DiagnosticSteps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#14161A" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#93C5FD" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- SSH Key Store -->
                        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="SSH Keys (DPAPI Protected)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBox Width="160" Text="{Binding NewKeyName}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Generate ECDSA Key" Command="{Binding GenerateSshKeyCommand}" />
                                    <Button Content="Import Existing Key" Margin="8,0,0,0" Command="{Binding ImportSshKeyCommand}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding SshKeys}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                                        <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" Width="160" />
                                        <DataGridTextColumn Header="Fingerprint (SHA256)" Binding="{Binding FingerprintSha256}" Width="*" />
                                        <DataGridTemplateColumn Header="Actions" Width="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Copy Public Key" Padding="8,2"
                                                                Command="{Binding DataContext.CopyPublicKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Delete" Padding="8,2" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.DeleteSshKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 2: Processes -->
                <TabItem>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Width="240" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Refresh Processes" Command="{Binding RefreshProcessesCommand}" />
                                <Button Style="{StaticResource DangerButton}" Content="End Selected Process" Margin="8,0,0,0" Command="{Binding EndSelectedProcessCommand}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding FilteredProcesses}" SelectedItem="{Binding SelectedProcess}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="200" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="75" />
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}%}" Width="80" />
                                    <DataGridTextColumn Header="Working Set (bytes)" Binding="{Binding WorkingSetBytes, StringFormat={}{0:N0}}" Width="150" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" />
                                    <DataGridTextColumn Header="Executable Path" Binding="{Binding Path}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- 3: Services -->
                <TabItem>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Width="240" Text="{Binding ServiceFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Refresh Services" Command="{Binding RefreshServicesCommand}" />
                                <Button Content="Start" Margin="8,0,0,0" Command="{Binding StartSelectedServiceCommand}" />
                                <Button Content="Stop" Margin="8,0,0,0" Command="{Binding StopSelectedServiceCommand}" />
                                <Button Content="Restart" Margin="8,0,0,0" Command="{Binding RestartSelectedServiceCommand}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding FilteredServices}" SelectedItem="{Binding SelectedService}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                                    <DataGridTextColumn Header="Startup Type" Binding="{Binding StartMode}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- 4: SSH Terminal -->
                <TabItem>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="Open / Reconnect Shell" Command="{Binding OpenTerminalCommand}" />
                                <Button Content="Close Shell" Margin="8,0,0,0" Command="{Binding CloseTerminalCommand}" />
                                <TextBlock Text="Interactive PowerShell over SSH (WebView2 + xterm.js)" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                            <wv2:WebView2 x:Name="TerminalWebView" />
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- 5: Actions & Events -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <WrapPanel>
                                <Button Content="Load Event Logs (24h)" Command="{Binding LoadEventLogsCommand}" Margin="0,0,8,4" />
                                <Button Content="Load Installed Software" Command="{Binding LoadInstalledSoftwareCommand}" Margin="0,0,8,4" />
                                <Button Content="Flush DNS Cache" Command="{Binding FlushDnsCommand}" Margin="0,0,8,4" />
                                <Button Content="Export Performance Report" Command="{Binding ExportPerformanceReportCommand}" Margin="0,0,8,4" />
                                <Button Style="{StaticResource DangerButton}" Content="Restart Remote PC" Command="{Binding RestartRemoteComputerCommand}" Margin="0,0,8,4" />
                                <Button Style="{StaticResource DangerButton}" Content="Shut Down Remote PC" Command="{Binding ShutdownRemoteComputerCommand}" Margin="0,0,8,4" />
                            </WrapPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Windows Event Log Summary" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <DataGrid ItemsSource="{Binding EventLogs}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="60" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Installed Software Inventory" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <DataGrid ItemsSource="{Binding InstalledSoftware}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 6: Logs -->
                <TabItem>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding LogFilePath, StringFormat='Log File: {0}'}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding LogEntries}" Background="#111317" BorderThickness="0"
                                     Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="12" />
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- 7: Settings -->
                <TabItem>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Telemetry &amp; Monitoring Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Polling Interval (seconds):" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding AvailableIntervals}" SelectedItem="{Binding PollIntervalSeconds}" Width="90" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding IsPollingPaused}" Foreground="{StaticResource TextPrimary}"
                                      Content="Pause live telemetry polling" />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
