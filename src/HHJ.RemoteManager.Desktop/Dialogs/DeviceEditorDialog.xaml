<Window x:Class="HHJ.RemoteManager.Desktop.Dialogs.DeviceEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Profile"
        Width="480" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#181A1F" Foreground="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Display Name (e.g. Brother-PC)" Margin="0,0,0,4" />
            <TextBox x:Name="DisplayNameBox" Margin="0,0,0,10" />

            <TextBlock Text="Tailscale MagicDNS Hostname or Private IP" Margin="0,0,0,4" />
            <TextBox x:Name="AddressBox" Margin="0,0,0,10" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SSH Port" Margin="0,0,0,4" />
                    <TextBox x:Name="PortBox" Text="22" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Authorized Windows Username" Margin="0,0,0,4" />
                    <TextBox x:Name="UsernameBox" />
                </StackPanel>
            </Grid>

            <TextBlock Text="SSH Private Key" Margin="0,0,0,4" />
            <ComboBox x:Name="KeyCombo" DisplayMemberPath="Name" Margin="0,0,0,10" />

            <TextBlock Text="Tags (comma-separated, optional)" Margin="0,0,0,4" />
            <TextBox x:Name="TagsBox" Margin="0,0,0,8" />

            <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" IsCancel="True" Click="OnCancel" />
            <Button Content="Save" Width="90" Margin="10,0,0,0" IsDefault="True"
                    Background="#3B82F6" Foreground="#FFFFFF" BorderThickness="0" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
