<Window x:Class="HHJ.Agent.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HHJ Agent Setup — Authorized Remote Management Installer"
        Width="860" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="HHJ Agent Setup" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StageTitle}" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                           Text="{Binding ComputerName, StringFormat='Endpoint: {0}'}" />
            </DockPanel>
        </Border>

        <!-- Stage Content -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Error / Status Banner -->
                    <Border Background="#3B1D22" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FCA5A5" />
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#93C5FD" Margin="0,0,0,10"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <!-- Stage 0: Consent -->
                    <StackPanel Visibility="{Binding IsStage0, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Authorized Remote Management Setup" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12">
                            This wizard configures native Windows components for authorized personal administration via HHJ Remote Manager:
                        </TextBlock>
                        <TextBlock Text="• Windows OpenSSH Server (sshd service, Automatic startup)" Margin="8,2" />
                        <TextBlock Text="• Tailscale private VPN client (official signed installer, user-confirmed enrollment)" Margin="8,2" />
                        <TextBlock Text="• Windows Defender Firewall rule scoped to Tailscale peers only" Margin="8,2" />
                        <TextBlock Text="• Your SSH public key added to the standard OpenSSH authorized_keys file" Margin="8,2,0,12" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12">
                            All components remain visible in Windows Services, Settings, and Firewall, and can be removed at any time via 'Disable Remote Access' or '--disable'.
                        </TextBlock>
                        <Border Background="#1D2A3A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                Visibility="{Binding ExistingInstallDetected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Existing HHJ Agent Setup configuration detected. Re-running is idempotent and will preserve your settings." TextWrapping="Wrap" />
                        </Border>
                        <CheckBox IsChecked="{Binding ConsentAccepted}" FontWeight="SemiBold" Margin="0,4,0,14"
                                  Content="I own this computer or am explicitly authorized to administer it, and I consent to enabling remote management." />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Next: Run Pre-Checks"
                                    Command="{Binding RunPreChecksCommand}" IsEnabled="{Binding ConsentAccepted}" />
                            <Button Style="{StaticResource DangerButton}" Content="Disable Remote Access" Margin="10,0,0,0"
                                    Command="{Binding DisableRemoteAccessCommand}"
                                    Visibility="{Binding ExistingInstallDetected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stage 1: Pre-Checks -->
                    <StackPanel Visibility="{Binding IsStage1, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="System Pre-Installation Checks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding PreCheckItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181B20" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#93C5FD" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Re-run Checks" Command="{Binding RunPreChecksCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Next: Configure OpenSSH" Margin="10,0,0,0"
                                    Command="{Binding ConfigureOpenSshCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stage 2: OpenSSH -->
                    <StackPanel Visibility="{Binding IsStage2, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Windows OpenSSH Server" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding OpenSshSummary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <CheckBox IsChecked="{Binding SetPowerShellDefaultShell}" Margin="0,0,0,12"
                                  Content="Set OpenSSH DefaultShell to Windows PowerShell (HKLM\SOFTWARE\OpenSSH\DefaultShell)" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply OpenSSH Configuration" Command="{Binding ConfigureOpenSshCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Next: Tailscale VPN" Margin="10,0,0,0"
                                    Command="{Binding EnterTailscaleStageCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stage 3: Tailscale -->
                    <StackPanel Visibility="{Binding IsStage3, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Tailscale Private Network" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TailscaleStateSummary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding TailscaleUnattendedConsent}" Margin="0,0,0,10"
                                  Content="Enable unattended Windows mode so remote access survives restarts without desktop login" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Optional Hostname:" Margin="0,0,8,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TailscaleHostname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Optional One-Time Auth Key:" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TailscaleAuthKey, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding TailscaleDownloadProgress}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource PrimaryButton}" Content="Install / Enroll Tailscale" Command="{Binding InstallOrEnrollTailscaleCommand}" />
                            <Button Content="Re-authenticate" Margin="8,0,0,0" Command="{Binding ForceReauthTailscaleCommand}" />
                            <Button Content="Refresh Status" Margin="8,0,0,0" Command="{Binding RefreshTailscaleStatusCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="{Binding TailscaleLoginUrl, Converter={StaticResource BoolToVis}}">
                            <TextBox Width="420" IsReadOnly="True" Text="{Binding TailscaleLoginUrl}" />
                            <Button Content="Copy URL" Margin="8,0,0,0" Command="{Binding CopyLoginUrlCommand}" />
                            <Button Content="Open Browser" Margin="8,0,0,0" Command="{Binding OpenLoginUrlCommand}" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding TailnetConfirmed}" Margin="0,4,0,10"
                                  Content="I confirm this computer is enrolled in my intended tailnet." />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource DangerButton}" Content="Reject &amp; Logout" Command="{Binding RejectTailnetCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Next: SSH Authentication" Margin="10,0,0,0"
                                    Command="{Binding EnterAuthStageCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stage 4: Auth -->
                    <StackPanel Visibility="{Binding IsStage4, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SSH Public-Key Authentication" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Target Windows Account:" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding LocalUsers}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username"
                                  Width="260" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Text="Paste Administrator SSH Public Key (.pub, single line):" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PublicKeyText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding KeyValidationMessage}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding KeyFingerprintDisplay}" Foreground="#93C5FD" FontFamily="Consolas" Margin="0,0,0,10" />
                        <TextBlock Text="Key Label:" Margin="0,0,0,4" />
                        <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding KeyLabel}" Margin="0,0,0,10" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Authorize Key &amp; Inspect Firewall"
                                HorizontalAlignment="Left" Command="{Binding ApplyAuthAndPrepareFirewallCommand}" />
                        <TextBlock Text="Authorized HHJ Keys on this Account:" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding ManagedKeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Revoke" Padding="8,3"
                                                Command="{Binding DataContext.RevokeKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas"
                                                   Text="{Binding FingerprintSha256, StringFormat='SHA256:{0}'}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Stage 5: Firewall -->
                    <StackPanel Visibility="{Binding IsStage5, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Windows Defender Firewall" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding FirewallPlanSummary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="Broad Pre-Existing Rules Detected (uncheck to keep enabled):" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding BroadRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding DisableRule}" Content="{Binding Reason}" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource PrimaryButton}" Content="Apply Firewall &amp; Finish" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding ApplyFirewallAndFinishCommand}" />
                    </StackPanel>

                    <!-- Stage 6: Completion -->
                    <StackPanel Visibility="{Binding IsStage6, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Remote Management Ready" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding ComputerName, StringFormat='Computer: {0}'}" Margin="0,2" />
                        <TextBlock Text="{Binding FinalOsSummary, StringFormat='OS: {0}'}" Margin="0,2" />
                        <TextBlock Text="{Binding FinalSshdSummary, StringFormat='OpenSSH (sshd): {0}'}" Margin="0,2" />
                        <TextBlock Text="{Binding FinalTailscaleSummary, StringFormat='Tailscale: {0}'}" Margin="0,2" />
                        <TextBlock Text="{Binding FinalVpnAddress, StringFormat='VPN Address / MagicDNS: {0}'}" Margin="0,2" />
                        <TextBlock Text="{Binding FinalUsername, StringFormat='Authorized SSH User: {0}'}" Margin="0,2" />
                        <TextBlock Text="{Binding ConnectionTestResult, StringFormat='Connection Test: {0}'}" Margin="0,6" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LogPath, StringFormat='Setup Log: {0}'}" Foreground="{StaticResource TextMuted}" Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" />
                            <Button Content="View Details" Margin="8,0,0,0" Command="{Binding ViewDetailsCommand}" />
                            <Button Style="{StaticResource DangerButton}" Content="Disable Remote Access" Margin="8,0,0,0" Command="{Binding DisableRemoteAccessCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Finish" Margin="8,0,0,0" Command="{Binding FinishCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Live Setup Log -->
        <Border Grid.Row="2" Background="#111317" BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="11" />
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Left" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                       Text="HHJ Remote Manager — Transparent, Consent-Based Windows Administration" />
        </DockPanel>
    </Grid>
</Window>
